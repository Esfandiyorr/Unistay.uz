{
  "name": "unistay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "dev": "node scripts/dev.mjs",
    "git:sync": "node scripts/configure-git-sync.mjs",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply DB --config dist/server/wrangler.json --local --persist-to .wrangler/state"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.27.4",
    "wrangler": "4.92.0"
  },
  "dependencies": {
    "jose": "6.2.18"
  }
}
