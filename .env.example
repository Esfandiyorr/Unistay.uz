# Local Vercel preview (npm run dev:vercel). Copy to .env.local; never commit real values.
# Without a URL the preview uses a SQLite file: file:dist/vercel-dev/local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Google OAuth web client; add http://127.0.0.1:4174/admin/google/callback as a redirect URI for local sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Admin Google address(es), comma separated.
UNISTAY_ADMIN_EMAIL=
# Optional extra key for admin session cookies.
SESSION_SECRET=
